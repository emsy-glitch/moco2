# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ADMIN SECURITY CONFIGURATION (Recommended for production deployment)
# Leave blank in prototype mode; configure strong credentials via Secrets before publishing.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""
ADMIN_MFA_SECRET=""
SESSION_SECRET=""
NODE_ENV="development"
